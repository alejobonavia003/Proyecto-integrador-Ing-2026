<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Inscripción a Finales</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gray-100">
<div class="flex min-h-screen">
    <main class="flex-1 p-10 max-w-5xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-bold text-gray-800">Gestión de Exámenes Finales</h2>
            <a href="/student/dashboard" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded shadow">Volver al Dashboard</a>
        </div>

        {{#errorMessage}}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow-sm">
            <p class="font-bold"><i class="fa-solid fa-circle-xmark mr-2"></i>Inscripción Rechazada</p>
            <p>{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        {{#successMessage}}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded shadow-sm">
            <p class="font-bold"><i class="fa-solid fa-check-circle mr-2"></i>Éxito!</p>
            <p>Operación realizada correctamente.</p>
        </div>
        {{/successMessage}}

        <h3 class="text-xl font-semibold text-gray-700 mb-4 border-b pb-2">Mis Inscripciones Actuales</h3>
        <div class="bg-white rounded-xl shadow overflow-hidden mb-10 border border-emerald-200">
            <table class="w-full text-left">
                <thead class="bg-emerald-700 text-white">
                    <tr>
                        <th class="p-4">Materia</th>
                        <th class="p-4">Fecha del Examen</th>
                        <th class="p-4">Fecha en la que te anotaste</th>
                    </tr>
                </thead>
                <tbody>
                    {{#myExams}}
                    <tr class="border-b hover:bg-emerald-50">
                        <td class="p-4 font-semibold">{{subject_code}} - {{subject_name}}</td>
                        <td class="p-4">{{exam_date}}</td>
                        <td class="p-4 text-gray-600">{{enrolled_at}}</td>
                    </tr>
                    {{/myExams}}
                    {{^myExams}}
                    <tr>
                        <td colspan="3" class="p-8 text-center text-gray-500 italic">No estás anotado en ningún examen final actualmente.</td>
                    </tr>
                    {{/myExams}}
                </tbody>
            </table>
        </div>

        <h3 class="text-xl font-semibold text-gray-700 mb-4 border-b pb-2">Mesas Disponibles para Anotarse</h3>
        <div class="bg-white rounded-xl shadow overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-slate-800 text-white">
                    <tr>
                        <th class="p-4">Materia</th>
                        <th class="p-4">Fecha del Examen</th>
                        <th class="p-4 text-right">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {{#availableExams}}
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-4 font-semibold">{{subject_code}} - {{subject_name}}</td>
                        <td class="p-4">{{exam_date}}</td>
                        <td class="p-4 text-right">
                            <form action="/student/exams/enroll" method="POST">
                                <input type="hidden" name="final_exam_id" value="{{id}}">
                                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm transition">
                                    <i class="fa-solid fa-pen-nib mr-1"></i> Anotarme
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/availableExams}}
                    {{^availableExams}}
                    <tr>
                        <td colspan="3" class="p-8 text-center text-gray-500">No hay nuevas mesas de exámenes habilitadas para tu plan de estudios.</td>
                    </tr>
                    {{/availableExams}}
                </tbody>
            </table>
        </div>
    </main>
</div>
</body>
</html>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Inscriptos a Plan</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

    <div class="flex min-h-screen">

        {{>partials/admin_sidebar}}

        <main class="flex-1 p-8">

            <div class="bg-white rounded-xl shadow p-6 mb-8">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-3xl font-bold text-gray-800">
                            {{plan_name}}
                        </h2>

                        <p class="text-gray-500 mt-2">
                            Código:
                            <span class="font-semibold text-cyan-600">
                                {{plan_code}}
                            </span>
                        </p>
                    </div>
            </div>


            {{#hasStudents}}

            <div class="bg-white rounded-xl shadow overflow-hidden">

                <div class="p-6 border-b">
                    <h3 class="text-xl font-bold text-gray-800">
                        Alumnos inscriptos al plan
                    </h3>
                </div>

                <div class="overflow-x-auto">

                    <table class="w-full text-left">

                        <thead class="bg-gray-50 border-b">
                            <tr>
                                <th class="p-4">ID</th>
                                <th class="p-4">DNI</th>
                                <th class="p-4">Nombre</th>
                                <th class="p-4">Email</th>
                            </tr>
                        </thead>

                        <tbody>

                            {{#students}}
                            <tr class="border-b hover:bg-gray-50">

                                <td class="p-4">
                                    {{id}}
                                </td>

                                <td class="p-4">
                                    {{dni}}
                                </td>

                                <td class="p-4 font-medium">
                                    {{name}}
                                </td>

                                <td class="p-4 text-cyan-700">
                                    {{email}}
                                </td>
                            </tr>
                            {{/students}}

                        </tbody>

                    </table>

                </div>

            </div>
            {{/hasStudents}}

            {{^hasStudents}}
    
            <div class="mt-5 bg-yellow-100 border border-yellow-300 text-yellow-800 rounded-xl p-5">
                No hay alumnos inscriptos.
            </div>

            {{/hasStudents}}
            <div class="mt-5">
                <a href="javascript:history.back()"><i class="fa-solid fa-arrow-left"></i> Volver</a>
            </div>
        </main>
        
    </div>
</body>
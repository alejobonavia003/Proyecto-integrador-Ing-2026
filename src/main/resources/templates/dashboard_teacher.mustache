<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Panel Docente</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/teacher_sidebar}}

    <main class="flex-1 p-8">

        <div class="bg-white rounded-xl shadow p-6 mb-8">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">
                        Bienvenido/a, Profesor/a {{username}} 📚
                    </h2>
                    <p class="text-gray-500 mt-2">
                        Rol:
                        <span class="font-semibold text-emerald-600">
                            {{role}}
                        </span>
                    </p>
                </div>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded shadow-sm" role="alert">
            <p class="font-bold"><i class="fa-solid fa-check-circle mr-2"></i>¡Éxito!</p>
            <p>{{successMessage}}</p>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow-sm" role="alert">
            <p class="font-bold"><i class="fa-solid fa-circle-xmark mr-2"></i>Error</p>
            <p>{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-emerald-500">
                <p class="text-gray-500 text-sm">Materias Asignadas</p>
                <h3 class="text-3xl font-bold mt-2">{{#materiasCount}}{{materiasCount}}{{/materiasCount}}{{^materiasCount}}0{{/materiasCount}}</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-blue-500">
                <p class="text-gray-500 text-sm">Comisiones Asociadas</p>
                <h3 class="text-3xl font-bold mt-2">{{#comisionesCount}}{{comisionesCount}}{{/comisionesCount}}{{^comisionesCount}}0{{/comisionesCount}}</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-yellow-500 opacity-50">
                <p class="text-gray-500 text-sm">Evaluaciones (Próximamente)</p>
                <h3 class="text-3xl font-bold mt-2">--</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-red-500">
                <p class="text-gray-500 text-sm">Tareas creadas</p>
                <h3 class="text-3xl font-bold mt-2">{{#tasksCount}}{{tasksCount}}{{/tasksCount}}{{^tasksCount}}0{{/tasksCount}}</h3>
            </div>

        </div>

    </main>

</div>

</body>
</html>
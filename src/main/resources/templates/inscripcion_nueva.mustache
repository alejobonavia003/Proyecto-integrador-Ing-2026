<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Inscripción a Materias</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard">Sistema Gestión Universitario</a>
            <div class="d-flex text-white align-items-center">
                Bienvenido, {{username}} <a href="/logout" class="btn btn-outline-light btn-sm ms-3">Cerrar Sesión</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h2>Oferta de Materias</h2>
        <p class="text-muted">Selecciona la comisión en la materia a la cual deseas inscribirte.</p>

        {{#errorMessage}}
        <div class="alert alert-danger shadow-sm">
            <h5 class="alert-heading">No se pudo procesar la inscripción</h5>
            <p class="mb-0">{{errorMessage}}</p>
            
            {{#hasFaltantes}}
            <hr>
            <p class="mb-1 fw-bold">Necesitas regularizar/aprobar primero las siguientes materias:</p>
            <ul class="mb-0">
                {{#faltantes}}
                <li>{{name}} <span class="badge bg-secondary">{{code}}</span></li>
                {{/faltantes}}
            </ul>
            {{/hasFaltantes}}
        </div>
        {{/errorMessage}}

        <div class="card shadow-sm mt-4">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Materia</th>
                            <th class="text-end pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#materiasDisponibles}}
                        <tr>
                            <td class="ps-4"><span class="badge bg-secondary">{{code}}</span></td>
                            <td class="fw-bold">{{name}}</td>
                            <td class="text-end pe-4">
                                {{#hasComisiones}}
                                <form action="/student/inscripciones/confirmar" method="POST" class="d-inline-flex">
                                    <input type="hidden" name="subject_id" value="{{id}}">
                                    <select name="course_class_id" class="form-select form-select-sm me-2" style="width: auto;" required>
                                        <option value="" disabled selected>Elegir Comisión...</option>
                                        {{#comisiones}}
                                        <option value="{{id}}">{{name}}</option>
                                        {{/comisiones}}
                                    </select>
                                    <button type="submit" class="btn btn-success btn-sm">Anotarme</button>
                                </form>
                                {{/hasComisiones}}
                                
                                {{^hasComisiones}}
                                <span class="text-muted fst-italic">Sin comisiones abiertas</span>
                                {{/hasComisiones}}
                            </td>
                        </tr>
                        {{/materiasDisponibles}}
                        
                        {{^materiasDisponibles}}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No hay materias disponibles para tu plan de estudios.</td>
                        </tr>
                        {{/materiasDisponibles}}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4">
            <a href="/student/mis-inscripciones" class="btn btn-secondary">Ver mis inscripciones</a>
        </div>
    </div>
</body>
</html>
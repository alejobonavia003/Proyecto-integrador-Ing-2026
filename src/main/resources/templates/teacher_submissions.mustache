<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>SGE - Entregas de Alumnos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/teacher_sidebar}}

    <main class="flex-1 p-8 space-y-6">

        <div class="bg-white rounded-xl shadow p-6">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">
                        📥 Trabajos Entregados por Alumnos
                    </h2>
                    <p class="text-gray-500 mt-1">
                        Descargue los archivos adjuntos, asigne calificaciones y redacte devoluciones académicas.
                    </p>
                </div>
                <a href="/teacher/tasks" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-xl shadow transition text-sm font-semibold">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Volver a Tareas
                </a>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-r-xl shadow-sm text-green-700">
            <span class="font-bold"><i class="fa-solid fa-circle-check mr-2"></i> Éxito:</span> Calificación registrada correctamente.
        </div>
        {{/successMessage}}

        <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-100">
                <h3 class="font-bold text-gray-800 text-lg flex items-center gap-2">
                    <i class="fa-solid fa-file-invoice text-slate-500"></i> Entregas Registradas
                </h3>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-400 text-xs uppercase tracking-wider border-b border-gray-100">
                            <th class="p-5 font-semibold w-1/4">Estudiante</th>
                            <th class="p-5 font-semibold w-1/5">Fecha de Entrega</th>
                            <th class="p-5 font-semibold w-1/5">Documento</th>
                            <th class="p-5 font-semibold w-1/3">Calificación y Comentario de Corrección</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-700 text-sm">
                        {{#submissions}}
                        <tr class="hover:bg-gray-50/60 transition aligned-row">
                            <td class="p-5 font-semibold text-slate-800">
                                <i class="fa-solid fa-user text-slate-400 mr-2"></i>{{student_name}}
                            </td>
                            <td class="p-5 text-gray-500">
                                {{submitted_at}}
                            </td>
                            <td class="p-5">
                                {{#content_reference}}
                                <a href="/teacher/submissions/download/{{id}}" 
                                   class="inline-flex items-center gap-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold px-3 py-2 rounded-lg border border-blue-200 transition">
                                    <i class="fa-solid fa-download"></i> Descargar TP
                                </a>
                                {{/content_reference}}
                                {{^content_reference}}
                                <span class="text-gray-400 italic">Sin archivo</span>
                                {{/content_reference}}
                            </td>
                            <td class="p-5">
                                <form action="/teacher/submissions/{{id}}/grade" method="POST" class="space-y-3 grading-form">
                                    <input type="hidden" name="assignment_id" class="global-assignment-id">
                                    
                                    <div class="flex items-center gap-3">
                                        <div class="w-24">
                                            <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Nota</label>
                                            <input type="number" name="grade" step="0.1" min="1" max="10" 
                                                   value="{{grade}}" placeholder="1-10" required
                                                   class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2 font-bold text-gray-800 text-center focus:outline-none focus:ring-2 focus:ring-emerald-400">
                                        </div>
                                        <div class="flex-1">
                                            <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Feedback / Comentario</label>
                                            <input type="text" name="comment" value="{{comment}}" placeholder="Escriba una devolución para el alumno..." required
                                                   class="w-full bg-gray-50 border border-gray-200 rounded-lg p-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                                        </div>
                                    </div>
                                    <div class="flex justify-end">
                                        <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs px-4 py-2 rounded-lg shadow-sm transition flex items-center gap-1">
                                            <i class="fa-solid fa-floppy-disk"></i> Guardar Nota
                                        </button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        {{/submissions}}
                        {{^submissions}}
                        <tr>
                            <td colspan="4" class="p-16 text-center text-gray-400 italic">
                                <i class="fa-solid fa-users-slash text-4xl mb-3 block text-gray-300"></i>
                                Ningún alumno ha realizado entregas para esta tarea todavía.
                            </td>
                        </tr>
                        {{/submissions}}
                    </tbody>
                </table>
            </div>
        </div>

    </main>

</div>

<script>
    // Al cargar la página, extrae el ID de la tarea desde la URL (/teacher/tasks/:id/submissions)
    // y lo inyecta automáticamente en todos los formularios de la tabla.
    document.addEventListener("DOMContentLoaded", function() {
        const pathParts = window.location.pathname.split('/');
        // En la ruta /teacher/tasks/1/submissions, el índice 3 corresponde al ID "1"
        const assignmentId = pathParts[3]; 
        
        if (assignmentId) {
            const hiddenInputs = document.querySelectorAll(".global-assignment-id");
            hiddenInputs.forEach(input => {
                input.value = assignmentId;
            });
        }
    });
</script>

</body>
</html>
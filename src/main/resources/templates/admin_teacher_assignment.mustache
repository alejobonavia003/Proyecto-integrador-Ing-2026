<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Asignación de Docentes</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/admin_sidebar}}

    <main class="flex-1 p-8">

        <!-- HEADER -->
        <div class="bg-white rounded-xl shadow p-6 mb-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <div>

                    <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-3">
                        <i class="fa-solid fa-chalkboard-user text-indigo-600"></i>
                        Gestión de Asignaciones Docentes
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Vincula docentes a carreras y materias del sistema.
                    </p>

                </div>

                <a href="/admin/dashboard"
                   class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-5 py-3 rounded-lg font-semibold transition text-center">

                    <i class="fa-solid fa-arrow-left mr-2"></i>
                    Volver al Dashboard

                </a>

            </div>

        </div>

        <!-- MENSAJES -->
        {{#successCareer}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
            ✅ El docente ha sido asignado a la carrera exitosamente.
        </div>
        {{/successCareer}}

        {{#successSubject}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
            ✅ El docente ha sido asignado a la materia exitosamente.
        </div>
        {{/successSubject}}

        {{#error}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
            ❌ {{error}}
        </div>
        {{/error}}

        <!-- GRID -->
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">

            <!-- CARRERAS -->
            <div class="bg-white rounded-xl shadow-lg p-8 border-l-4 border-indigo-500">

                <div class="mb-6">

                    <h2 class="text-2xl font-bold text-gray-800">
                        Vincular a Carrera
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Registra un docente dentro de una carrera habilitada.
                    </p>

                </div>

                <form action="/admin/teacher-assignments/career"
                      method="POST"
                      class="space-y-6">

                    <div>

                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Seleccionar Docente
                        </label>

                        <select name="teacher_id"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">

                            <option value="" disabled selected>
                                -- Elija un Profesor --
                            </option>

                            {{#teachers}}
                            <option value="{{id}}">
                                {{name}} (DNI: {{dni}})
                            </option>
                            {{/teachers}}

                        </select>

                    </div>

                    <div>

                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Seleccionar Carrera
                        </label>

                        <select name="career_id"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">

                            <option value="" disabled selected>
                                -- Elija una Carrera --
                            </option>

                            {{#careers}}
                            <option value="{{id}}">
                                {{name}} [{{code}}]
                            </option>
                            {{/careers}}

                        </select>

                    </div>

                    <button type="submit"
                            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition">

                        <i class="fa-solid fa-link mr-2"></i>
                        Asignar a Carrera

                    </button>

                </form>

            </div>

            <!-- MATERIAS -->
            <div class="bg-white rounded-xl shadow-lg p-8 border-l-4 border-cyan-500">

                <div class="mb-6">

                    <h2 class="text-2xl font-bold text-gray-800">
                        Vincular a Materia
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Asigna docentes a materias con rol y período académico.
                    </p>

                </div>

                <form action="/admin/teacher-assignments/subject"
                      method="POST"
                      class="space-y-6">

                    <div>

                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Seleccionar Docente
                        </label>

                        <select name="teacher_id"
                                id="select-teacher"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-white">

                            <option value="" disabled selected>
                                -- Elija un Profesor --
                            </option>

                            {{#teachers}}
                            <option value="{{id}}">
                                {{name}} (DNI: {{dni}})
                            </option>
                            {{/teachers}}

                        </select>

                    </div>

                    <div>

                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Seleccionar Materia
                        </label>

                        <select name="subject_id"
                                id="select-subject"
                                required
                                disabled
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-gray-200 focus:outline-none">

                            <option value="" disabled selected>
                                -- Seleccione primero un profesor --
                            </option>

                        </select>

                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <div>

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Rol / Carga
                            </label>

                            <input type="text"
                                   name="role_charge"
                                   placeholder="Ej: Titular, JTP"
                                   required
                                   class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500">

                        </div>

                        <div>

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Año Académico
                            </label>

                            <input type="number"
                                   name="academic_year"
                                   value="2026"
                                   min="2020"
                                   max="2100"
                                   required
                                   class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500">

                        </div>

                    </div>

                    <div>

                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Periodo Académico
                        </label>

                        <select name="academic_period"
                                required
                                class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-white">

                            <option value="1° Cuatrimestre">
                                1° Cuatrimestre
                            </option>

                            <option value="2° Cuatrimestre">
                                2° Cuatrimestre
                            </option>

                            <option value="Anual">
                                Anual
                            </option>

                        </select>

                    </div>

                    <button type="submit"
                            class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-semibold py-3 rounded-lg transition">

                        <i class="fa-solid fa-floppy-disk mr-2"></i>
                        Asignar a Materia

                    </button>

                </form>

            </div>

        </div>

    </main>

</div>

<script>
    document.getElementById('select-teacher').addEventListener('change', function() {

        const teacherId = this.value;
        const subjectSelect = document.getElementById('select-subject');

        subjectSelect.innerHTML =
            '<option value="" disabled selected>Cargando materias...</option>';

        subjectSelect.disabled = true;

        subjectSelect.classList.replace('bg-white', 'bg-gray-200');

        if (!teacherId) return;

        fetch(`/admin/teacher-assignments/allowed-subjects?teacher_id=${teacherId}`)

            .then(response => response.json())

            .then(subjects => {

                subjectSelect.innerHTML = '';

                if (subjects.length === 0) {

                    subjectSelect.innerHTML =
                        '<option value="" disabled selected>⚠ El profesor no pertenece a ninguna carrera o no hay materias libres</option>';

                } else {

                    subjectSelect.innerHTML =
                        '<option value="" disabled selected>-- Elija una Materia --</option>';

                    subjects.forEach(subject => {

                        const option = document.createElement('option');

                        option.value = subject.id;

                        option.textContent =
                            `${subject.name} [${subject.code}]`;

                        subjectSelect.appendChild(option);
                    });

                    subjectSelect.disabled = false;
                    subjectSelect.classList.replace('bg-gray-200', 'bg-white');
                }
            })

            .catch(error => {

                console.error('Error al cargar las materias:', error);

                subjectSelect.innerHTML =
                    '<option value="" disabled selected>❌ Error al cargar materias</option>';
            });
    });
</script>

</body>
</html>
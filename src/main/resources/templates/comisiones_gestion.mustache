<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>SGE - Gestión de Comisiones</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/teacher_sidebar}}

    <main class="flex-1 p-8 space-y-8">

        <div class="bg-white rounded-xl shadow p-6">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">
                        👥 Gestión de Comisiones y Alumnos
                    </h2>
                    <p class="text-gray-500 mt-2">
                        Bienvenido, Docente <span class="font-semibold text-slate-700">{{username}}</span>
                    </p>
                </div>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-r-xl shadow-sm text-green-700">
            <span class="font-bold"><i class="fa-solid fa-circle-check mr-2"></i> Éxito:</span> {{successMessage}}
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl shadow-sm text-red-700">
            <span class="font-bold"><i class="fa-solid fa-circle-xmark mr-2"></i> Error:</span> {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <section class="lg:col-span-5 bg-white rounded-xl shadow p-6 flex flex-col justify-between">
                <div>
                    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-folder-plus text-emerald-500"></i> Crear Nueva Comisión
                    </h3>
                    <form action="/teacher/comisiones/crear" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-600 mb-1">Materia (Solo donde eres Titular):</label>
                            <select name="subject_id" required class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition">
                                <option value="" disabled selected>Seleccione una materia...</option>
                                {{#materiasTitular}}
                                <option value="{{id}}">{{name}} (Código: {{code}})</option>
                                {{/materiasTitular}}
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-600 mb-1">Nombre/Número de la Comisión:</label>
                            <input type="text" name="name" placeholder="Ej: Comisión A1" required class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-600 mb-1">Cupo de Alumnos (Capacidad Máxima):</label>
                            <input type="number" name="quota" value="30" min="1" required class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition">
                        </div>

                        <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-3 px-4 rounded-xl shadow-md transition duration-200 mt-2">
                            <i class="fa-solid fa-circle-check mr-1"></i> Habilitar Comisión
                        </button>
                    </form>
                </div>
            </section>

            <section class="lg:col-span-7 bg-white rounded-xl shadow p-6">
                <h3 class="text-xl font-bold text-gray-800 mb-1 flex items-center gap-2">
                    <i class="fa-solid fa-filter text-blue-500"></i> Filtros de Alumnos Inscriptos
                </h3>
                <p class="text-gray-400 text-sm mb-6">Filtre de forma combinada. Las listas se actualizarán automáticamente.</p>
                
                <form action="/teacher/comisiones" method="GET" class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex flex-col gap-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Carrera</label>
                            <select name="career_id" onchange="this.form.submit()" class="w-full bg-white border border-gray-200 rounded-lg p-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400 cursor-pointer">
                                <option value="">Todas las Carreras</option>
                                {{#carrerasFiltro}}
                                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                {{/carrerasFiltro}}
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Materia</label>
                            <select name="subject_id" onchange="this.form.submit()" class="w-full bg-white border border-gray-200 rounded-lg p-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400 cursor-pointer">
                                <option value="">Todas las Materias</option>
                                {{#materiasFiltro}}
                                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                {{/materiasFiltro}}
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Comisión</label>
                            <select name="course_class_id" onchange="this.form.submit()" class="w-full bg-white border border-gray-200 rounded-lg p-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400 cursor-pointer">
                                <option value="">Todas las Comisiones</option>
                                {{#comisionesFiltro}}
                                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                {{/comisionesFiltro}}
                            </select>
                        </div>

                    </div>
                    
                    <div class="flex justify-end mt-2">
                        <a href="/teacher/comisiones" class="bg-gray-200 hover:bg-gray-300 text-gray-700 text-sm font-semibold py-2 px-4 rounded-lg transition inline-flex items-center">
                            <i class="fa-solid fa-eraser mr-1"></i> Limpiar Filtros
                        </a>
                    </div>
                </form>
                <div class="space-y-5">
                    <form action="/teacher/comisiones" method="GET" class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-gray-50 p-3 rounded-xl border border-gray-100">
                        <span class="text-sm font-medium text-gray-600 px-1"><i class="fa-solid fa-graduation-cap text-gray-400 w-5"></i> Filtrar por Carrera:</span>
                        <select name="career_id" onchange="this.form.submit()" class="bg-white border border-gray-200 rounded-lg p-2 text-sm text-gray-700 min-w-[240px] focus:outline-none focus:ring-2 focus:ring-blue-400">
                            <option value="">Seleccione Carrera...</option>
                            {{#carrerasFiltro}}
                            <option value="{{id}}">{{name}}</option>
                            {{/carrerasFiltro}}
                        </select>
                    </form>

                    <form action="/teacher/comisiones" method="GET" class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-gray-50 p-3 rounded-xl border border-gray-100">
                        <span class="text-sm font-medium text-gray-600 px-1"><i class="fa-solid fa-book text-gray-400 w-5"></i> Filtrar por Materia:</span>
                        <select name="subject_id" onchange="this.form.submit()" class="bg-white border border-gray-200 rounded-lg p-2 text-sm text-gray-700 min-w-[240px] focus:outline-none focus:ring-2 focus:ring-blue-400">
                            <option value="">Seleccione Materia...</option>
                            {{#materiasFiltro}}
                            <option value="{{id}}">{{name}}</option>
                            {{/materiasFiltro}}
                        </select>
                    </form>

                    <form action="/teacher/comisiones" method="GET" class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-gray-50 p-3 rounded-xl border border-gray-100">
                        <span class="text-sm font-medium text-gray-600 px-1"><i class="fa-solid fa-chalkboard-user text-gray-400 w-5"></i> Filtrar por Comisión:</span>
                        <select name="course_class_id" onchange="this.form.submit()" class="bg-white border border-gray-200 rounded-lg p-2 text-sm text-gray-700 min-w-[240px] focus:outline-none focus:ring-2 focus:ring-blue-400">
                            <option value="">Seleccione Comisión...</option>
                            {{#comisionesFiltro}}
                            <option value="{{id}}">{{name}}</option>
                            {{/comisionesFiltro}}
                        </select>
                    </form>
                </div>
            </section>
        </div>

        <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <h3 class="font-bold text-gray-800 text-lg flex items-center gap-2">
                    <i class="fa-solid fa-list text-slate-500"></i> Listado de Estudiantes
                </h3>
                {{#filtroAplicado}}
                <span class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-xs font-semibold border border-blue-100">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                    Filtro: {{filtroAplicado}}
                </span>
                {{/filtroAplicado}}
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-400 text-xs uppercase tracking-wider border-b border-gray-100">
                            <th class="p-5 font-semibold w-1/4">DNI</th>
                            <th class="p-5 font-semibold w-2/5">Nombre y Apellido</th>
                            <th class="p-5 font-semibold w-7/20">Email</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-700 text-sm">
                        {{#alumnos}}
                        <tr class="hover:bg-gray-50/60 transition">
                            <td class="p-5 font-medium text-gray-900">{{dni}}</td>
                            <td class="p-5 font-semibold text-slate-800">{{name}}</td>
                            <td class="p-5 text-gray-500">{{email}}</td>
                        </tr>
                        {{/alumnos}}
                    </tbody>
                </table>
            </div>

            {{^alumnos}}
            <div class="p-16 text-center text-gray-400 italic">
                <i class="fa-solid fa-users-slash text-4xl mb-3 block text-gray-300"></i>
                No se encontraron alumnos registrados para el filtro seleccionado.
            </div>
            {{/alumnos}}
        </div>

    </main>

</div>

</body>
</html>
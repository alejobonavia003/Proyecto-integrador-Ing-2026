<h2>Crear Tarea</h2>
<form method="post" action="/teacher/tasks/new" enctype="multipart/form-data">
  <label>Título: <input type="text" name="title" required></label><br>
  <label>Descripción:<br><textarea name="description"></textarea></label><br>
  <label>Carrera:
    <select name="career_id">
      {{#careers}}
      <option value="{{id}}">{{name}}</option>
      {{/careers}}
    </select>
  </label><br>
  <label>Materia:
    <select name="subject_id" id="subject_select">
      <option value="">-- Seleccione --</option>
      {{#subjects}}
      <option value="{{id}}">{{name}}</option>
      {{/subjects}}
    </select>
  </label><br>
  <div id="classes_container" style="display:none;">
    <label>Comisión (opcional):
      <select name="course_class_id" id="class_select">
        <option value="">-- Seleccione comisión --</option>
      </select>
    </label>
    <label style="margin-left:1rem;"> <input type="checkbox" name="all_comisions" id="all_comisions"> Todas las comisiones</label>
  </div>
  <label>Archivo (opcional): <input type="file" name="file"></label><br>
  <button type="submit">Crear tarea</button>
</form>

<script>
  document.getElementById('subject_select').addEventListener('change', function() {
    const subjectId = this.value;
    const container = document.getElementById('classes_container');
    const classSelect = document.getElementById('class_select');
    classSelect.innerHTML = '<option value="">-- Seleccione comisión --</option>';
    document.getElementById('all_comisions').checked = false;
    if (!subjectId) { container.style.display = 'none'; return; }
    fetch('/teacher/tasks/classes?subject_id=' + subjectId)
      .then(r => r.json())
      .then(data => {
        if (Array.isArray(data) && data.length > 0) {
          data.forEach(function(cc){
            const opt = document.createElement('option');
            opt.value = cc.id; opt.text = cc.name;
            classSelect.appendChild(opt);
          });
          container.style.display = 'block';
        } else {
          // no comisiones
          container.style.display = 'none';
        }
      }).catch(err => { console.error(err); container.style.display = 'none'; });
  });

  // If 'all_comisions' checked, disable class select
  document.getElementById('all_comisions').addEventListener('change', function(){
    document.getElementById('class_select').disabled = this.checked;
  });
</script>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SGE - Crear Tarea</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/teacher_sidebar}}

    <main class="flex-1 p-8 space-y-6">
        <div class="bg-white rounded-xl shadow p-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">📝 Crear Nueva Tarea Académica</h2>
                    <p class="text-gray-500 mt-1">Asigne consignas y materiales de estudio a sus alumnos.</p>
                </div>
                <a href="/teacher/tasks" class="text-gray-400 hover:text-gray-600 transition">
                    <i class="fa-solid fa-circle-arrow-left text-3xl"></i>
                </a>
            </div>
        </div>

        {{#errorMessage}}
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl shadow-sm text-red-700">
            <span class="font-bold">Error:</span> {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="bg-white rounded-xl shadow p-6">
            <form action="/teacher/tasks/new" method="POST" enctype="multipart/form-data" class="space-y-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Título de la Tarea:</label>
                    <input type="text" name="title" required placeholder="Ej: Trabajo Práctico Integrador N° 1" 
                           class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition">
                </div>
                
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Descripción / Consigna Extensa:</label>
                    <textarea name="description" required rows="5" placeholder="Escriba aquí los criterios básicos, pautas de desarrollo y entrega..."
                              class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition"></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Materia Asociada:</label>
                        <select name="subject_id" id="subject_id" required class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition">
                            <option value="" disabled selected>Seleccione una materia...</option>
                            {{#subjects}}
                            <option value="{{id}}">{{name}}</option>
                            {{/subjects}}
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Comisión Destinataria:</label>
                        <select name="course_class_id" id="course_class_id" class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition">
                            <option value="">Seleccione primero una materia...</option>
                        </select>
                        
                        <div class="mt-3">
                            <label class="inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="all_comisions" class="form-checkbox h-5 w-5 text-emerald-500 rounded border-gray-300">
                                <span class="ml-2 text-sm text-gray-600 font-medium">Asignar de forma global a todas las comisiones</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Archivo de Soporte / Enunciado (Opcional):</label>
                    <input type="file" name="file" class="w-full border border-gray-200 p-2 rounded-xl bg-gray-50 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                </div>

                <div class="flex gap-4 pt-4 border-t border-gray-100">
                    <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition duration-200">
                        <i class="fa-solid fa-paper-plane mr-1"></i> Publicar Tarea
                    </button>
                    <a href="/teacher/tasks" class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-semibold px-6 py-3 rounded-xl transition">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </main>

</div>

<script>
    document.getElementById('subject_id').addEventListener('change', function() {
        const subjectId = this.value;
        const classSelect = document.getElementById('course_class_id');
        classSelect.innerHTML = '<option value="">Cargando comisiones asociadas...</option>';
        
        if(subjectId) {
            fetch('/teacher/tasks/classes?subject_id=' + subjectId)
                .then(response => response.json())
                .then(data => {
                    classSelect.innerHTML = '<option value="">Seleccione comisión...</option>';
                    if(data.length === 0) {
                        classSelect.innerHTML = '<option value="">No hay comisiones asignadas</option>';
                    } else {
                        data.forEach(c => {
                            classSelect.innerHTML += `<option value="${c.id}">${c.name}</option>`;
                        });
                    }
                })
                .catch(() => {
                    classSelect.innerHTML = '<option value="">Error al cargar los datos</option>';
                });
        }
    });
</script>
</body>
</html>
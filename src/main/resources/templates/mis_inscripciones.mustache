<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis Inscripciones</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">

<div class="flex min-h-screen">

    {{>partials/student_sidebar}}

    <main class="flex-1 p-10 max-w-5xl mx-auto">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
            <h2 class="text-3xl font-bold text-gray-800">Mis Inscripciones Actuales</h2>
            
            <div class="flex gap-3">
                <a href="/student/dashboard" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg shadow transition flex items-center">
                    Volver al Panel
                </a>
                <a href="/student/inscripciones/nueva" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow transition flex items-center gap-2 font-medium">
                    <i class="fa-solid fa-plus"></i> Nueva Inscripción
                </a>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded shadow-sm">
            <p class="font-bold"><i class="fa-solid fa-check-circle mr-2"></i>¡Éxito!</p>
            <p>{{successMessage}}</p>
        </div>
        {{/successMessage}}

        <div class="bg-white rounded-xl shadow overflow-hidden border border-slate-200">
            <table class="w-full text-left">
                <thead class="bg-slate-800 text-white">
                    <tr>
                        <th class="p-4">Materia</th>
                        <th class="p-4">Comisión (ID)</th>
                    </tr>
                </thead>
                <tbody>
                    {{#inscripciones}}
                    <tr class="border-b hover:bg-slate-50 transition">
                        <td class="p-4 font-semibold text-gray-800">
                            <i class="fa-solid fa-book text-slate-400 mr-2"></i> {{materia_name}}
                        </td>
                        <td class="p-4 text-gray-600 font-mono font-medium">
                            {{comision_id}}
                        </td>
                    </tr>
                    {{/inscripciones}}
                    
                    {{^inscripciones}}
                    <tr>
                        <td colspan="2" class="p-12 text-center text-gray-500">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-folder-open text-gray-400 text-2xl"></i>
                            </div>
                            <p class="italic">No te encuentras inscripto en ninguna materia actualmente.</p>
                        </td>
                    </tr>
                    {{/inscripciones}}
                </tbody>
            </table>
        </div>

    </main>
</div>

</body>
</html>
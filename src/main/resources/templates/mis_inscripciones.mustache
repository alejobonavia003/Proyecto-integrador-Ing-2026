<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis Inscripciones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard">Sistema Gestión Universitario</a>
            <div class="d-flex text-white align-items-center">
                Bienvenido, {{username}} <a href="/logout" class="btn btn-outline-light btn-sm ms-3">Cerrar Sesión</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Mis Inscripciones Actuales</h2>
            <a href="/student/inscripciones/nueva" class="btn btn-primary">Nueva Inscripción</a>
        </div>

        {{#successMessage}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{successMessage}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{/successMessage}}

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Materia</th>
                            <th>Comisión (ID)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#inscripciones}}
                        <tr>
                            <td class="ps-4 fw-bold">{{materia_name}}</td>
                            <td>{{comision_id}}</td>
                        </tr>
                        {{/inscripciones}}
                        {{^inscripciones}}
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                No te encuentras inscripto en ninguna materia actualmente.
                            </td>
                        </tr>
                        {{/inscripciones}}
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-4">
            <a href="/dashboard" class="btn btn-secondary">Volver al Panel</a>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
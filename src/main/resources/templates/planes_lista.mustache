<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Planes de Estudio</title>
    </head>
<body>
    <h1>Planes de Estudio Existentes</h1>
    
    <a href="/planes/nuevo" class="btn btn-primary">Crear Nuevo Plan</a>
    
    <hr>

    <table border="1" cellpadding="10" cellspacing="0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Código</th>
                <th>Nombre del Plan</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#planes}}
            <tr>
                <td>{{id}}</td>
                <td>{{code}}</td>
                <td>{{name}}</td>
                <td>
                    <a href="/planes/{{id}}">Ver Detalle</a> | 
                    <a href="/planes/{{id}}/editar">Editar</a>
                </td>
            </tr>
            {{/planes}}
            
            {{^planes}}
            <tr>
                <td colspan="4" style="text-align:center;">No hay planes de estudio registrados.</td>
            </tr>
            {{/planes}}
        </tbody>
    </table>
</body>
</html>
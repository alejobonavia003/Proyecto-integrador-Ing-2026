<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Crear cuenta de Administrador</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900 min-h-screen py-10 px-6 flex items-center justify-center p-6">

    <div class="w-full max-w-md">

        <div class="text-center mb-8">

            <h1 class="text-5xl font-extrabold text-white tracking-wide">
                SGE
            </h1>
            
            <p class="text-cyan-300 mt-2 text-lg">
                Sistema de Gestión Educativa
            </p>

        </div>

        <div class="bg-white/95 backdrop-blur rounded-2xl shadow-2xl p-8 border border-white/20">

            <div class="text-center mb-8">

                <div class="w-16 h-16 mx-auto bg-cyan-100 rounded-full flex items-center justify-center mb-4">
                    <i class="fa-solid fa-user-shield text-cyan-700 text-2xl"></i>
                </div>

                <h2 class="text-3xl font-bold text-gray-800">
                    Crear cuenta
                </h2>

                <p class="text-gray-500 mt-2">
                    Registro inicial de administrador
                </p>

            </div>

            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-xl mb-5">
                {{successMessage}}
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl mb-5">
                {{errorMessage}}
            </div>
            {{/errorMessage}}

            <form action="/user/new" method="POST" class="space-y-5">

                <div>
                    <label for="name"
                           class="block text-sm font-semibold text-gray-700 mb-2">
                        Nombre
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        placeholder="Ingrese el nombre"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition">
                </div>

                <div>
                    <label for="dni"
                           class="block text-sm font-semibold text-gray-700 mb-2">
                        DNI
                    </label>

                    <input
                        type="text"
                        id="dni"
                        name="dni"
                        required
                        pattern="[0-9]+"
                        inputmode="numeric"
                        title="El DNI debe contener únicamente números."
                        placeholder="Ingrese el DNI (solo números)"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition">
                    <p class="text-xs text-gray-400 mt-1">Solo se permiten caracteres numéricos.</p>
                </div>

                <div>
                    <label for="email"
                           class="block text-sm font-semibold text-gray-700 mb-2">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        placeholder="Ingrese el email"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition">
                </div>

                <div>
                    <label for="password"
                           class="block text-sm font-semibold text-gray-700 mb-2">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        placeholder="Ingrese la contraseña"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition">
                </div>

                <div>
                    <label for="role" class="block text-sm font-semibold text-gray-700 mb-2">
                        Rol de Usuario
                    </label>
                    <select id="role" name="role" required 
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition bg-white">
                        <option value="" disabled selected>Seleccione un rol...</option>
                        <option value="ADMIN">Administrador</option>
                        <option value="TEACHER">Docente</option>
                        <option value="STUDENT">Alumno</option>
                    </select>
                </div>

                <button
                    type="submit"
                    class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-3 rounded-xl transition duration-200 shadow-lg hover:shadow-cyan-500/30">

                    Registrar Administrador

                </button>

                <div class="text-center pt-2">

                    <a href="/"
                       class="text-cyan-700 hover:text-cyan-900 hover:underline text-sm font-semibold transition">

                        &larr; Volver al inicio

                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>
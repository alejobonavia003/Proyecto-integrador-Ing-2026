<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Elegir Carrera</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">

<div class="flex min-h-screen">

    {{>partials/student_sidebar}}

    <main class="flex-1 p-10 max-w-5xl mx-auto">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
            <div>
                <h2 class="text-3xl font-bold text-gray-800">Seleccionar Carrera 🎓</h2>
                <p class="text-gray-500 mt-2">Inscríbete a un plan de estudios para comenzar a cursar materias.</p>
            </div>
            <a href="/student/dashboard" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg shadow transition flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
        </div>

        {{#errorMessage}}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow-sm">
            <p class="font-bold"><i class="fa-solid fa-circle-xmark mr-2"></i>Error al procesar</p>
            <p>{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        <div class="bg-white rounded-xl shadow overflow-hidden border border-slate-200">
            <table class="w-full text-left">
                <thead class="bg-slate-800 text-white">
                    <tr>
                        <th class="p-4 font-semibold">Carrera</th>
                        <th class="p-4 font-semibold">Plan de Estudios</th>
                        <th class="p-4 font-semibold text-right">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {{#planes}}
                    <tr class="border-b hover:bg-slate-50 transition items-center">
                        <td class="p-4 font-bold text-blue-600 text-lg">
                            {{career_name}}
                        </td>
                        <td class="p-4 text-gray-700 font-medium">
                            {{name}}
                        </td>
                        <td class="p-4 text-right">
                            <form action="/student/carrera/confirmar" method="POST" class="m-0">
                                <input type="hidden" name="plan_id" value="{{id}}">
                                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg text-sm font-bold shadow-sm transition duration-200 flex inline-flex items-center gap-2" onclick="return confirm('¿Confirmas que deseas anotarte a la carrera de {{career_name}} (Plan: {{name}})?');">
                                    <i class="fa-solid fa-check"></i> Inscribirme
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/planes}}
                    
                    {{^planes}}
                    <tr>
                        <td colspan="3" class="p-12 text-center text-gray-500">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fa-solid fa-folder-open text-gray-400 text-2xl"></i>
                            </div>
                            <p class="italic text-lg">Actualmente no hay carreras ni planes de estudio habilitados.</p>
                        </td>
                    </tr>
                    {{/planes}}
                </tbody>
            </table>
        </div>

    </main>
</div>

</body>
</html>
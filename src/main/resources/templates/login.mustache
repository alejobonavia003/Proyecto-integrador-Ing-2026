<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Iniciar Sesión</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900 min-h-screen py-10 px-6 flex items-center justify-center">

    <div class="w-full max-w-md">

        <!-- LOGO -->
        <div class="text-center mb-8">

            <h1 class="text-5xl font-extrabold text-white tracking-wide">
                SGE
            </h1>

            <p class="text-cyan-300 mt-2 text-lg">
                Sistema de Gestión Educativa
            </p>

        </div>

        <!-- CARD LOGIN -->
        <div class="bg-white/95 backdrop-blur rounded-2xl shadow-2xl p-8 border border-white/20">

            <div class="text-center mb-8">

                <div class="w-16 h-16 mx-auto bg-cyan-100 rounded-full flex items-center justify-center mb-4">
                    <i class="fa-solid fa-user-lock text-cyan-700 text-2xl"></i>
                </div>

                <h2 class="text-3xl font-bold text-gray-800">
                    Iniciar Sesión
                </h2>

                <p class="text-gray-500 mt-2">
                    Accedé al sistema con tu cuenta
                </p>

            </div>

            <!-- SUCCESS -->
            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-xl mb-5">
                {{successMessage}}
            </div>
            {{/successMessage}}

            <!-- ERROR -->
            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl mb-5">
                {{errorMessage}}
            </div>
            {{/errorMessage}}

            <!-- FORM -->
            <form action="/login" method="POST" class="space-y-5">

                <div>
                    <label for="username"
                           class="block text-sm font-semibold text-gray-700 mb-2">
                        Nombre de Usuario
                    </label>

                    <input
                        type="text"
                        id="username"
                        name="username"
                        required
                        placeholder="Ingrese su usuario"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition">
                </div>

                <div>
                    <label for="password"
                           class="block text-sm font-semibold text-gray-700 mb-2">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        placeholder="Ingrese su contraseña"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition">
                </div>

                <button
                    type="submit"
                    class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-3 rounded-xl transition duration-200 shadow-lg hover:shadow-cyan-500/30">

                    Iniciar Sesión

                </button>

            </form>

            <!-- LINKS -->
            <div class="text-center mt-6 space-y-2">

                <p class="text-gray-600 text-sm">
                    ¿No tienes una cuenta?
                    <a href="/user/create"
                       class="text-cyan-700 hover:text-cyan-900 hover:underline font-semibold">
                        Regístrate aquí
                    </a>
                </p>

            </div>

        </div>

    </div>
    <div id="animation-overlay" class="fixed inset-0 z-[-1] flex items-center justify-center opacity-0 transition-opacity duration-300 pointer-events-none overflow-hidden bg-slate-900/80 backdrop-blur-sm">
    
    <div id="expanding-circle" class="absolute w-4 h-4 bg-cyan-500 rounded-full opacity-80" style="transform: scale(0); transition: transform 1.2s cubic-bezier(0.85, 0, 0.15, 1);"></div>
    
    <div id="success-content" class="relative z-10 flex flex-col items-center opacity-0 transition-opacity duration-500 delay-500 transform translate-y-4 transition-transform">
        <div class="w-24 h-24 border-4 border-white rounded-full flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(34,211,238,0.6)]">
            <i class="fa-solid fa-check text-5xl text-white"></i>
        </div>
        <h2 class="text-4xl font-extrabold text-white tracking-widest drop-shadow-[0_0_15px_rgba(34,211,238,0.8)]">
            ACCESO CONCEDIDO
        </h2>
        <p class="text-cyan-200 mt-3 text-lg font-mono tracking-wider">Iniciando sistema SGE...</p>
    </div>
</div>
<script>
    const form = document.querySelector('form');
    const loginCard = document.querySelector('.bg-white\\/95'); // Tu tarjeta de login
    const submitBtn = document.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
        e.preventDefault(); // Evitamos que la página se recargue inmediatamente

        // Ponemos el botón en estado de carga
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Autenticando...';
        submitBtn.disabled = true;

        try {
            // Enviamos los datos a AuthController.java en segundo plano
            const formData = new URLSearchParams(new FormData(form));
            const response = await fetch('/login', {
                method: 'POST',
                body: formData,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });

            // Truco: Fetch sigue las redirecciones (el res.redirect de Spark).
            // Si la URL final tiene "error=", falló el login.
            if (response.url.includes('error=')) {
                // Dejamos que el sistema recargue para mostrar tu mensaje de error normal
                window.location.href = response.url; 
            } else {
                // ¡LOGIN EXITOSO! INICIA LA ANIMACIÓN

                // 1. Desaparece la tarjeta de login
                loginCard.style.transition = 'all 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55)';
                loginCard.style.transform = 'scale(0.5) translateY(100px)';
                loginCard.style.opacity = '0';

                // 2. Muestra la capa de animación
                const overlay = document.getElementById('animation-overlay');
                const circle = document.getElementById('expanding-circle');
                const content = document.getElementById('success-content');

                setTimeout(() => {
                    overlay.classList.remove('z-[-1]', 'opacity-0', 'pointer-events-none');
                    overlay.classList.add('z-50', 'opacity-100');
                    
                    // 3. Explota el círculo (escala 250 veces su tamaño para cubrir la pantalla)
                    setTimeout(() => {
                        circle.style.transform = 'scale(250)';
                    }, 100);

                    // 4. Aparece el texto flotante
                    setTimeout(() => {
                        content.classList.remove('opacity-0', 'translate-y-4');
                        content.classList.add('opacity-100', 'translate-y-0');
                    }, 600);

                    // 5. Finalmente, redirige al dashboard de forma fluida
                    setTimeout(() => {
                        window.location.href = '/dashboard';
                    }, 2800); // Espera casi 3 segundos para que el usuario disfrute la animación

                }, 400);
            }
        } catch (error) {
            console.error("Error en el login:", error);
            submitBtn.innerHTML = originalBtnText;
            submitBtn.disabled = false;
        }
    });
</script>
</body>
</html>
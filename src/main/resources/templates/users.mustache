<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Usuarios</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen p-8">

    <div class="max-w-6xl mx-auto">

        <div class="bg-white p-6 rounded-lg shadow mb-6">
            <div class="flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">Gestión de Usuarios</h1>
                    <p class="text-gray-600 mt-2">Usuario: <span class="font-semibold">{{username}}</span></p>
                    <p class="text-gray-600">Rol: <span class="font-semibold text-blue-600">{{role}}</span></p>
                </div>
                
                <div class="flex gap-4">
                    <a href="/admin/users/new" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow font-semibold">
                        + Crear Nuevo Usuario
                    </a>
                    
                    <a href="/dashboard" class="bg-gray-700 hover:bg-gray-800 text-white px-4 py-2 rounded shadow font-semibold">
                        Volver al Dashboard
                    </a>
                </div>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <span>{{successMessage}}</span>
        </div>
        {{/successMessage}}

        <div class="bg-white p-6 rounded-lg shadow mb-6 flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-semibold text-gray-800">Usuarios Registrados</h2>
                <p class="text-gray-500 mt-2">Total mostrados: <span class="font-bold">{{userCount}}</span></p>
            </div>

            <form action="/admin/users" method="GET" class="flex items-center gap-2">
                <label for="roleFilter" class="font-medium text-gray-700">Filtrar por:</label>
                <select name="roleFilter" id="roleFilter" class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="ALL" {{#filterAll}}selected{{/filterAll}}>Mostrar Docentes y Alumnos</option>
                    <option value="2" {{#filterProfesor}}selected{{/filterProfesor}}>Solo Docentes</option>
                    <option value="3" {{#filterAlumno}}selected{{/filterAlumno}}>Solo Alumnos</option>
                </select>
                <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded border border-gray-300 font-semibold">
                    Filtrar
                </button>
            </form>
        </div>

        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="p-3 text-left">ID</th>
                        <th class="p-3 text-left">DNI</th>
                        <th class="p-3 text-left">Nombre</th>
                        <th class="p-3 text-left">Email</th>
                        <th class="p-3 text-left">Rol Asignado</th>
                    </tr>
                </thead>
                <tbody>
                    {{#users}}
                    <tr class="border-t hover:bg-gray-50">
                        <td class="p-3">{{id}}</td>
                        <td class="p-3">{{dni}}</td>
                        <td class="p-3 font-medium">{{name}}</td>
                        <td class="p-3 text-blue-600">{{email}}</td>
                        <td class="p-3">
                            <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded border border-blue-400">
                                {{role_name}}
                            </span>
                        </td>
                    </tr>
                    {{/users}}

                    {{^users}}
                    <tr>
                        <td colspan="5" class="p-6 text-center text-gray-500">
                            No existen usuarios registrados con este filtro.
                        </td>
                    </tr>
                    {{/users}}
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
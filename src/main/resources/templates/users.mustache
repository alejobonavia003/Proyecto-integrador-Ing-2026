<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Usuarios</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/admin_sidebar}}

    <main class="flex-1 p-8">

        <div class="bg-white rounded-xl shadow p-6 mb-8">

            <div class="flex justify-between items-center">

                <div>
                    <h1 class="text-3xl font-bold text-gray-800">
                        Gestión de Usuarios
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Administración de docentes y alumnos
                    </p>
                </div>

                <a href="/admin/users/new"
                   class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-3 rounded-lg transition">
                    + Crear Usuario
                </a>

            </div>

        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-300 text-green-700 px-4 py-3 rounded-lg mb-6">
            {{successMessage}}
        </div>
        {{/successMessage}}

        <div class="bg-white rounded-xl shadow p-6 mb-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <div>
                    <h2 class="text-2xl font-bold text-gray-800">
                        Usuarios Registrados
                    </h2>

                    <p class="text-gray-500 mt-1">
                        Total encontrados:
                        <span class="font-semibold">
                            {{userCount}}
                        </span>
                    </p>
                </div>

                <form action="/admin/users"
                      method="GET"
                      class="flex items-center gap-3">

                    <label for="roleFilter"
                           class="font-medium text-gray-700">
                        Filtrar:
                    </label>

                    <select name="roleFilter"
                            id="roleFilter"
                            class="border rounded-lg px-4 py-2 focus:ring-2 focus:ring-cyan-500 outline-none">

                        <option value="ALL"
                                {{#filterAll}}selected{{/filterAll}}>
                            Docentes y Alumnos
                        </option>

                        <option value="2"
                                {{#filterProfesor}}selected{{/filterProfesor}}>
                            Solo Docentes
                        </option>

                        <option value="3"
                                {{#filterAlumno}}selected{{/filterAlumno}}>
                            Solo Alumnos
                        </option>

                    </select>

                    <button type="submit"
                            class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded-lg transition">
                        Filtrar
                    </button>

                </form>

            </div>

        </div>

        <div class="bg-white rounded-xl shadow overflow-hidden">

            <div class="overflow-x-auto">

                <table class="w-full text-left">

                    <thead class="bg-gray-50 border-b">

                        <tr>
                            <th class="p-4">ID</th>
                            <th class="p-4">DNI</th>
                            <th class="p-4">Nombre</th>
                            <th class="p-4">Email</th>
                            <th class="p-4">Rol</th>
                        </tr>

                    </thead>

                    <tbody>

                        {{#users}}

                        <tr class="border-b hover:bg-gray-50">

                            <td class="p-4">
                                {{id}}
                            </td>

                            <td class="p-4">
                                {{dni}}
                            </td>

                            <td class="p-4 font-medium">
                                {{name}}
                            </td>

                            <td class="p-4 text-cyan-700">
                                {{email}}
                            </td>

                            <td class="p-4">

                                <span class="bg-cyan-100 text-cyan-800 text-xs font-semibold px-3 py-1 rounded-full">
                                    {{role_name}}
                                </span>

                            </td>

                        </tr>

                        {{/users}}

                        {{^users}}

                        <tr>
                            <td colspan="5"
                                class="p-8 text-center text-gray-500">
                                No existen usuarios registrados con este filtro.
                            </td>
                        </tr>

                        {{/users}}

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</div>

</body>
</html>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Panel Administrador</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/admin_sidebar}}

    <main class="flex-1 p-8">

        {{#successMessage}}
        <div class="mb-4">
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded" role="alert">
                <strong class="font-bold">Éxito: </strong>
                <span class="block sm:inline">{{successMessage}}</span>
            </div>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="mb-4">
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded" role="alert">
                <strong class="font-bold">Error: </strong>
                <span class="block sm:inline">{{errorMessage}}</span>
            </div>
        </div>
        {{/errorMessage}}

        <div class="bg-white rounded-xl shadow p-6 mb-8">

            <div class="flex justify-between items-center">

                <div>
                    <h2 class="text-3xl font-bold text-gray-800">
                        Bienvenido, {{username}} 👋
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Rol:
                        <span class="font-semibold text-cyan-600">
                            {{role}}
                        </span>
                    </p>
                </div>

            </div>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-blue-500 transition hover:shadow-lg">
                <p class="text-gray-500 text-sm font-medium">Usuarios</p>
                <h3 class="text-3xl font-bold mt-2 text-gray-800">{{userCount}}</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-green-500 transition hover:shadow-lg">
                <p class="text-gray-500 text-sm font-medium">Carreras</p>
                <h3 class="text-3xl font-bold mt-2 text-gray-800">{{careerCount}}</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-yellow-500 transition hover:shadow-lg">
                <p class="text-gray-500 text-sm font-medium">Materias</p>
                <h3 class="text-3xl font-bold mt-2 text-gray-800">{{subjectCount}}</h3>
            </div>

        </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <div class="bg-white rounded-xl shadow p-6">

                <h3 class="text-xl font-semibold mb-5">
                    Gestión de Usuarios
                </h3>

                <div class="flex flex-wrap gap-4">

                    <a href="/user/create"
                       class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-3 rounded-lg transition">
                        Registrar Usuario
                    </a>
                </div>

            </div>

            <div class="bg-white rounded-xl shadow p-6 border-l-4 border-indigo-500 hover:shadow-lg transition duration-200">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold text-gray-800">
                        Asignación de Cátedras
                    </h3>
                    <i class="fa-solid fa-chalkboard-user text-indigo-500 text-2xl"></i>
                </div>

                <p class="text-gray-500 text-sm mb-5">
                    Vincula a los profesores con las materias, definiendo su rol y el periodo académico en curso.
                </p>

                <a href="/admin/teacher-assignments"
                   class="block text-center bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-2.5 px-4 rounded-lg transition duration-200">
                    Gestionar Asignaciones
                </a>

            </div>

        </div>

    </main>

</div>

</body>
</html>
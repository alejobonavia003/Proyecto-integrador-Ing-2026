<!DOCTYPE html>
<html>
<head><title>Detalle de Carrera</title></head>
<body>
    <h1>Detalle de la Carrera: {{career_name}} ({{career_code}})</h1>
    <a href="/admin/careers"><button>Volver a Carreras</button></a>

    <h2>Planes de Estudio Asignados</h2>

    {{#hasPlans}}
        <table border="1">
            <thead>
                <tr>
                    <th>ID Plan</th>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Versión</th>
                </tr>
            </thead>
            <tbody>
                {{#plans}}
                <tr>
                    <td>{{id}}</td>
                    <td>{{name}}</td>
                    <td>{{code}}</td>
                    <td>{{version}}</td>
                </tr>
                {{/plans}}
            </tbody>
        </table>
        <br>
        <button onclick="alert('Funcionalidad en desarrollo')">Crear Otro Plan de Estudio</button>
    {{/hasPlans}}

    {{^hasPlans}}
        <p style="color: grey;">Esta carrera todavía no tiene ningún plan de estudio asignado.</p>
        <button onclick="alert('Funcionalidad en desarrollo')">Crear Plan de Estudio</button>
    {{/hasPlans}}

</body>
</html>
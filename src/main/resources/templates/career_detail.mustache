<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Detalle de Carrera y Planes</title>
</head>
<body>
    <h1>Detalles de la Carrera: {{career_name}}</h1>
    <p><strong>Código:</strong> {{career_code}}</p>
    
    <hr>

    <h2>Planes de Estudio de esta Carrera</h2>
    <a href="/admin/careers/{{career_id}}/plans/new"><button>+ Crear Nuevo Plan de Estudio</button></a>
    <br><br>

    {{#hasPlans}}
    <table border="1" cellpadding="10" cellspacing="0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre del Plan</th>
                <th>Código</th>
                <th>Versión</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#plans}}
            <tr>
                <td>{{id}}</td>
                <td>{{name}}</td>
                <td>{{code}}</td>
                <td>{{version}}</td>
                <td>
                    <a href="/admin/careers/{{career_id}}/plans/{{id}}"><button>Ver Materias del Plan</button></a>
                    <a href="/admin/careers/{{career_id}}/plans/{{id}}/subjects"><button>Gestionar Materias</button></a>
                </td>
            </tr>
            {{/plans}}
        </tbody>
    </table>
    {{/hasPlans}}
    
    {{^hasPlans}}
        <p><i>No hay planes de estudio registrados para esta carrera actualmente.</i></p>
    {{/hasPlans}}

    <br><br>
    <a href="/admin/careers"><button>Volver a la Lista de Carreras</button></a>
</body>
</html>
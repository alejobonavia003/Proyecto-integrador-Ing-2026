<aside class="w-72 bg-slate-900 text-white p-6 min-h-screen">

    <div class="mb-10">
        <h1 class="text-2xl font-bold">
            SGE <span class="text-cyan-400">ADMIN</span>
        </h1>

        <p class="text-gray-400 text-sm mt-1">
            Panel de Control
        </p>
    </div>

    <nav class="space-y-3">

        <!-- DASHBOARD -->
        <a href="/admin/dashboard"
           class="flex items-center gap-3 p-3 rounded transition
           {{#dashboardActive}}bg-cyan-500/20 border-l-4 border-cyan-400 text-white{{/dashboardActive}}
           {{^dashboardActive}}hover:bg-white/10{{/dashboardActive}}">
            <i class="fa-solid fa-gauge-high"></i>
            Dashboard
        </a>

        <!-- USUARIOS -->
        <a href="/admin/users"
           class="flex items-center gap-3 p-3 rounded transition

           {{^usersActive}}hover:bg-white/10{{/usersActive}}">
            <i class="fa-solid fa-users"></i>
            Usuarios
        </a>

        <!-- CARRERAS -->
        <a href="/admin/careers"
           class="flex items-center gap-3 p-3 rounded transition
           {{#careersActive}}bg-cyan-500/20 border-l-4 border-cyan-400 text-white{{/careersActive}}
           {{^careersActive}}hover:bg-white/10{{/careersActive}}">
            <i class="fa-solid fa-graduation-cap"></i>
            Carreras
        </a>

        <!-- MATERIAS -->
        <a href="/admin/subjects"
           class="flex items-center gap-3 p-3 rounded transition

<aside class="w-72 bg-slate-900 text-white p-6 flex flex-col justify-between shrink-0 min-h-screen">
    <div>
        <div class="mb-10">
            <h1 class="text-2xl font-bold">
                SGE <span class="text-emerald-400">DOCENTE</span>
            </h1>
            <p class="text-gray-400 text-sm mt-1">
                Panel Académico
            </p>
        </div>

        <nav class="space-y-3" id="sidebar-docente-menu">
            <a href="/teacher/dashboard"
               class="sidebar-link flex items-center gap-3 p-3 rounded transition hover:bg-white/10 text-gray-200">
                <i class="fa-solid fa-gauge-high w-5 text-center"></i>
                Dashboard
            </a>

            <a href="/teacher/comisiones"
               class="sidebar-link flex items-center gap-3 p-3 rounded transition hover:bg-white/10 text-gray-200">
                <i class="fa-solid fa-users-rectangle w-5 text-center"></i>
                Gestión de Comisiones
            </a>

            <a href="/teacher/grades"
               class="sidebar-link flex items-center gap-3 p-3 rounded transition hover:bg-white/10 text-gray-200">
                <i class="fa-solid fa-file-pen w-5 text-center"></i>
                Cargar Notas
            </a>

            <a href="/teacher/tasks"
               class="sidebar-link flex items-center gap-3 p-3 rounded transition hover:bg-white/10 text-gray-200">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                Publicar Tareas
            </a>

            <a href="/teacher/exams"
               class="sidebar-link flex items-center gap-3 p-3 rounded transition hover:bg-white/10 text-gray-200">
                <i class="fa-solid fa-list-ol w-5 text-center"></i>
                Ver Inscriptos a Finales
            </a>
        </nav>
    </div>

    <div class="mt-16">
        <a href="/logout"
           class="block text-center border border-red-500 text-red-400 hover:bg-red-500 hover:text-white transition rounded p-3">
            Cerrar Sesión
        </a>
    </div>
</aside>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll("#sidebar-docente-menu .sidebar-link");

        navLinks.forEach(link => {
            // Compara la ruta actual o si es una subruta (ej: /teacher/tasks/new activa "Publicar Tareas")
            const linkPath = link.getAttribute("href");
            if (currentPath === linkPath || (linkPath !== "/teacher/dashboard" && currentPath.startsWith(linkPath))) {
                link.classList.remove("hover:bg-white/10", "text-gray-200");
                link.classList.add("bg-emerald-500/20", "border-l-4", "border-emerald-400", "text-white", "font-semibold");
                
                // Ilumina el icono interno en verde esmeralda para mantener tu estilo
                const icon = link.querySelector("i");
                if (icon) icon.classList.add("text-emerald-400");
            }
        });
    });
</script>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Materias</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    {{>partials/admin_sidebar}}

    <main class="flex-1 p-8">

        <!-- HEADER -->
        <div class="bg-white rounded-xl shadow p-6 mb-8">

            <div class="flex justify-between items-center">

                <div>

                    <h1 class="text-3xl font-bold text-gray-800">
                        Gestión de Materias
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Administra todas las materias del sistema.
                    </p>

                </div>

                <a
                    href="/admin/subjects/new"
                    class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-3 rounded-lg font-semibold transition">

                    <i class="fa-solid fa-plus mr-2"></i>
                    Nueva Materia

                </a>

            </div>

        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <!-- STATS -->
        <div class="bg-white rounded-xl shadow p-6 mb-8 border-l-4 border-cyan-500">

            <p class="text-gray-500 text-sm">
                Total de materias registradas
            </p>

            <h2 class="text-3xl font-bold mt-2 text-gray-800">
                {{subjectCount}}
            </h2>

        </div>

        <!-- TABLA -->
        <div class="bg-white rounded-xl shadow overflow-hidden">

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-slate-100">

                        <tr>

                            <th class="p-4 text-left font-semibold text-gray-700">
                                ID
                            </th>

                            <th class="p-4 text-left font-semibold text-gray-700">
                                Código
                            </th>

                            <th class="p-4 text-left font-semibold text-gray-700">
                                Nombre
                            </th>

                            <th class="p-4 text-left font-semibold text-gray-700">
                                Horas
                            </th>

                            <th class="p-4 text-left font-semibold text-gray-700">
                                Modalidad
                            </th>

                            <th class="p-4 text-left font-semibold text-gray-700">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        {{#subjects}}
                        <tr class="border-t hover:bg-gray-50 transition">

                            <td class="p-4">
                                {{id}}
                            </td>

                            <td class="p-4 font-semibold text-cyan-700">
                                {{code}}
                            </td>

                            <td class="p-4 font-medium text-gray-800">
                                {{name}}
                            </td>

                            <td class="p-4">
                                {{weekly_hours}} hs
                            </td>

                            <td class="p-4">
                                <span class="bg-cyan-100 text-cyan-800 text-xs font-semibold px-3 py-1 rounded-full">
                                    {{modality}}
                                </span>
                            </td>

                            <td class="p-4">
                                <a href="/admin/subjects/{{id}}/students"
                                    class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm transition">
                                    Ver Inscriptos
                                </a>
                            </td>

                        </tr>
                        {{/subjects}}

                        {{^subjects}}
                        <tr>

                            <td
                                colspan="5"
                                class="p-8 text-center text-gray-500">

                                No existen materias registradas.

                            </td>

                        </tr>
                        {{/subjects}}

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</div>

</body>
</html>
<h2>Tareas disponibles</h2>
{{#tasks}}
<div style="border:1px solid #ddd;padding:8px;margin-bottom:8px;">
  <h3>{{title}}</h3>
  <p>{{description}}</p>
  {{#file_path}}<p>Archivo: <a href="/{{file_path}}">descargar</a></p>{{/file_path}}

  {{#submitted}}
    <p style="color:green;">Entregado ✅ - <a href="/{{submission_path}}">descargar entrega</a></p>
  {{/submitted}}

  <h2>Tareas disponibles</h2>
{{#tasks}}
<div style="border:1px solid #ddd;padding:8px;margin-bottom:8px;">
  <h3>{{title}}</h3>
  <p>{{description}}</p>
  {{#file_path}}<p>Archivo: <a href="/{{file_path}}">descargar</a></p>{{/file_path}}

  {{#submitted}}
    <p style="color:green; font-weight:bold;">Entregado ✅ - <a href="/{{submission_path}}">descargar mi entrega</a></p>
    
    <div style="margin-top:10px; padding:10px; background-color:#f4fbf7; border-left:4px solid #28a745; border-radius:2px;">
      {{#grade}}
        <p style="margin:2px 0;"><strong>Calificación:</strong> <span style="background-color:#28a745; color:white; padding:2px 6px; border-radius:3px; font-weight:bold;">{{grade}}</span></p>
      {{/grade}}
      {{^grade}}
        <p style="margin:2px 0; color:#666; font-style:italic;">Estado: Pendiente de corrección por el docente ⏳</p>
      {{/grade}}
      
      {{#comment}}
        <p style="margin:8px 0 2px 0;"><strong>Comentario del profesor:</strong></p>
        <blockquote style="margin:0; padding:8px; background:#fff; border:1px dashed #ccc; font-style:italic; border-radius:4px;">
          {{comment}}
        </blockquote>
      {{/comment}}
    </div>
  {{/submitted}}

  {{^submitted}}
    <form method="post" action="/student/tasks/{{id}}/submit" enctype="multipart/form-data">
      <label>Adjuntar archivo: <input type="file" name="file" required></label>
      <button type="submit">Entregar</button>
    </form>
  {{/submitted}}
</div>
{{/tasks}}

  {{^submitted}}
    <form method="post" action="/student/tasks/{{id}}/submit" enctype="multipart/form-data">
      <label>Adjuntar archivo: <input type="file" name="file" required></label>
      <button type="submit">Entregar</button>
    </form>
  {{/submitted}}
</div>
{{/tasks}}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Panel Alumno</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        @keyframes spin-fun {
            0% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(180deg) scale(1.2); }
            100% { transform: rotate(360deg) scale(1); }
        }
        .sombrerito-giratorio {
            display: inline-block;
            animation: spin-fun 1s ease-in-out;
        }
    </style>
</head>
</head>

<body class="bg-gray-100">

<div class="flex min-h-screen">

    <aside class="w-72 bg-slate-900 text-white p-6 flex flex-col">

        <div class="mb-10">
            <h1 class="text-2xl font-bold">
                SGE <span class="text-blue-400">ALUMNO</span>
            </h1>

            <p class="text-gray-400 text-sm mt-1">
                Portal Académico
            </p>
        </div>

        <nav class="space-y-3 flex-1">

            <a href="/student/dashboard"
               class="flex items-center gap-3 bg-blue-500/20 border-l-4 border-blue-400 p-3 rounded text-white">
                <i class="fa-solid fa-gauge-high"></i>
                Dashboard
            </a>

            <a href="/student/inscripciones/nueva"
               class="flex items-center gap-3 hover:bg-white/10 p-3 rounded transition">
                <i class="fa-solid fa-clipboard-check"></i>
                Inscribirse a Materias
            </a>

            <a href="/student/exams"
                class="flex items-center gap-3 hover:bg-white/10 p-3 rounded transition">
                <i class="fa-solid fa-pen-to-square"></i>
                Inscribirse a Finales
            </a>

            <a href="/student/mis-inscripciones"
               class="flex items-center gap-3 hover:bg-white/10 p-3 rounded transition">
                <i class="fa-solid fa-list-check"></i>
                Mis Inscripciones
            </a>
            
            {{^hasCareer}}
            <a href="/student/elegir-carrera"
               class="flex items-center gap-3 hover:bg-white/10 p-3 rounded transition text-yellow-400">
                <i class="fa-solid fa-graduation-cap"></i>
                Elegir Carrera
            </a>
            {{/hasCareer}}

        </nav>
        
        <div class="mt-auto">
            <a href="/logout" class="flex items-center gap-3 hover:bg-red-500/20 text-red-400 p-3 rounded transition">
                <i class="fa-solid fa-right-from-bracket"></i>
                Cerrar Sesión
            </a>
        </div>
    </aside>

    <main class="flex-1 p-10">
        
        <div class="flex justify-between items-center mb-8">
            <div class="flex items-center gap-4">
                <div class="bg-blue-100 p-3 rounded-full text-blue-600">
                    <i class="fa-solid fa-user-graduate text-2xl"></i>
                </div>
                <div>
                <h1 class="text-3xl font-bold text-gray-800">
                    Bienvenido, Alumno <span id="sombrerito-fun">🎓</span>
                </h1>

                    <p class="text-gray-500 mt-2">
                        Rol:
                        <span class="font-semibold text-blue-600">
                            {{role}}
                        </span>
                    </p>
                </div>
            </div>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded shadow-sm" role="alert">
            <p class="font-bold"><i class="fa-solid fa-check-circle mr-2"></i>¡Éxito!</p>
            <p>{{successMessage}}</p>
        </div>
        {{/successMessage}}
        
        {{#errorMessage}}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow-sm" role="alert">
            <p class="font-bold"><i class="fa-solid fa-circle-xmark mr-2"></i>Error</p>
            <p>{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        <div class="mb-8">
            {{#hasCareer}}
            <div class="bg-indigo-600 rounded-xl shadow-lg p-6 text-white flex items-center justify-between">
                <div>
                    <p class="text-indigo-200 text-sm font-semibold uppercase tracking-wider mb-1">Mi Carrera Actual</p>
                    <h3 class="text-2xl font-bold">{{careerName}}</h3>
                    <p class="text-indigo-100 mt-1"><i class="fa-solid fa-book-open mr-2"></i>Plan de Estudios: {{planName}}</p>
                </div>
                <div class="bg-indigo-500/50 p-4 rounded-full">
                    <i class="fa-solid fa-graduation-cap text-4xl"></i>
                </div>
            </div>
            {{/hasCareer}}
            
            {{^hasCareer}}
            <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-800 p-6 rounded-xl shadow-sm flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-bold mb-2"><i class="fa-solid fa-triangle-exclamation mr-2"></i>Acción Requerida</h3>
                    <p>No tienes una carrera asignada. Debes elegir una para poder inscribirte a materias.</p>
                </div>
                <a href="/student/elegir-carrera" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-6 rounded shadow transition">
                    Elegir Carrera
                </a>
            </div>
            {{/hasCareer}}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-blue-500">
                <p class="text-gray-500 text-sm">Materias Inscriptas</p>
                <h3 class="text-3xl font-bold mt-2">{{#hasCareer}}{{enrollmentsCount}}{{/hasCareer}}{{^hasCareer}}0{{/hasCareer}}</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-green-500">
                <p class="text-gray-500 text-sm">Promedio</p>
                <h3 class="text-3xl font-bold mt-2">{{averageGrade}}</h3>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-yellow-500">
                <p class="text-gray-500 text-sm">Tareas Pendientes</p>
                <h3 class="text-3xl font-bold mt-2">{{tasksCount}}</h3>
                <p class="mt-2"><a href="/student/tasks" class="text-blue-600 hover:underline">Ver mis tareas</a></p>
            </div>

            <div class="bg-white rounded-xl shadow p-5 border-l-4 border-red-500">
                <p class="text-gray-500 text-sm">Alertas</p>
                <h3 class="text-3xl font-bold mt-2">{{^hasCareer}}1{{/hasCareer}}{{#hasCareer}}0{{/hasCareer}}</h3>
            </div>

        </div>

    </main>
</div>
    <script>
        function animarSombrerito() {
            const sombrero = document.getElementById('sombrerito-fun');
            
            if (sombrero) {
                // Añade la clase que ejecuta la animación CSS
                sombrero.classList.add('sombrerito-giratorio');

                // Remueve la clase después de 1 segundo (cuando termina el giro)
                setTimeout(() => {
                    sombrero.classList.remove('sombrerito-giratorio');
                    
                    // Calcula un intervalo aleatorio entre 4 y 12 segundos para la próxima vuelta
                    const proximoGiro = Math.floor(Math.random() * (12000 - 4000 + 1) + 4000);
                    
                    // Programa el siguiente giro
                    setTimeout(animarSombrerito, proximoGiro);
                }, 1000);
            }
        }

        // Inicia el ciclo 2.5 segundos después de que se cargue la pantalla
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(animarSombrerito, 2500);
        });
    </script>
</body>
</html>
</body>
</html>
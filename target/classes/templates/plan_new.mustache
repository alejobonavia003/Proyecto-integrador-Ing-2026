<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nuevo Plan de Estudio</title>
</head>
<body>
    <h1>Crear Plan de Estudio</h1>
    <h3>Carrera: {{career_name}}</h3>

    {{#errorMessage}}
        <p style="color: red; font-weight: bold;">{{errorMessage}}</p>
    {{/errorMessage}}

    <form action="/admin/careers/{{career_id}}/plans/new" method="POST">
        <fieldset>
            <legend>Datos del Plan de Estudio</legend>
            
            <label for="name">Nombre del Plan (Ej. Plan Analista 2026):</label><br>
            <input type="text" id="name" name="name" required><br><br>

            <label for="code">Código (Ej. P-2026):</label><br>
            <input type="text" id="code" name="code" required><br><br>

            <label for="version">Versión (Año de resolución):</label><br>
            <input type="text" id="version" name="version" required><br><br>
        </fieldset>
        
        <br>
        <button type="submit">Guardar Plan de Estudio</button>
        <a href="/admin/careers/{{career_id}}"><button type="button">Cancelar</button></a>
    </form>
</body>
</html>